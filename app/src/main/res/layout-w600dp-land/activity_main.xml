<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/app_background">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/app_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingStart="4dp"
            android:paddingEnd="12dp" />

        <TextView
            android:id="@+id/sleepTimerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_codec_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text=""
            android:textColor="@color/app_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:id="@+id/topSpacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/searchOnlineButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Search Internet Radio"
            android:padding="12dp"
            android:src="@drawable/ic_search"
            app:tint="@color/app_text_primary" />

        <ImageButton
            android:id="@+id/addStationButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Add Station"
            android:padding="12dp"
            android:src="@drawable/ic_add"
            app:tint="@color/app_text_primary" />

        <ImageButton
            android:id="@+id/mainMenuAnchor"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More options"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/app_text_primary" />
    </LinearLayout>

    <!-- Two-Pane Tablet Landscape Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Left Pane: Now Playing Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.42"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/nowPlayingThumb"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/ic_launcher"
                        android:contentDescription="Current station thumbnail" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.example.radioplayer.MarqueeTextView
                        android:id="@+id/currentStationView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center_horizontal"
                        android:text="@string/select_station"
                        android:textColor="@color/app_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/streamStatusIndicator"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/status_circle_red" />
                </LinearLayout>

                <com.example.radioplayer.MarqueeTextView
                    android:id="@+id/songTitleView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="24dp"
                    android:layout_marginTop="6dp"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_horizontal"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="@color/app_accent" />

                <TextView
                    android:id="@+id/codecInfoView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_codec_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text=""
                    android:textColor="@color/app_text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.45"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="6dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_volume"
                            android:contentDescription="@string/volume_label"
                            app:tint="@color/app_text_secondary" />

                        <SeekBar
                            android:id="@+id/mainVolumeSeekBar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="52dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:progressDrawable="@drawable/volume_progress"
                            android:splitTrack="false"
                            android:thumb="@drawable/volume_thumb" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.55"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageButton
                            android:id="@+id/previousButton"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Previous station"
                            android:padding="5dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_skip_previous"
                            app:tint="@color/app_text_primary" />

                        <ImageButton
                            android:id="@+id/playPauseButton"
                            android:layout_width="62dp"
                            android:layout_height="62dp"
                            android:layout_marginHorizontal="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Play or Pause"
                            android:padding="2dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_play"
                            app:tint="@color/app_accent" />

                        <ImageButton
                            android:id="@+id/nextButton"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Next station"
                            android:padding="5dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_skip_next"
                            app:tint="@color/app_text_primary" />

                        <ImageButton
                            android:id="@+id/equalizerButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/sound_equalizer"
                            android:padding="7dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_equalizer"
                            app:tint="@color/app_text_primary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Right Pane: Capture Panel + Tabs + Station List -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.58"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/capturePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_codec_pill"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:id="@+id/captureHeaderRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/captureStatusDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/status_circle_red"
                        android:alpha="0.35" />

                    <TextView
                        android:id="@+id/captureHeaderText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Stream Capture"
                        android:textColor="@color/app_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/captureFoldIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="12sp"
                        android:paddingHorizontal="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/captureControlsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageButton
                            android:id="@+id/captureRecordPauseButton"
                            android:layout_width="48dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="16dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Record or Pause"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_record"
                            app:tint="@color/app_accent" />

                        <ImageButton
                            android:id="@+id/captureStopButton"
                            android:layout_width="48dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="16dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Stop"
                            android:enabled="false"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_stop"
                            app:tint="@color/app_text_primary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/captureDetailText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Ready to capture active stream"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/stationsTab"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/stations_label"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/app_text_primary"
                        android:clickable="true"
                        android:focusable="true" />

                    <View
                        android:id="@+id/stationsTabIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@color/app_accent" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/favoritesTab"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/favorites_label"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/app_text_secondary"
                        android:clickable="true"
                        android:focusable="true" />

                    <View
                        android:id="@+id/favoritesTabIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@color/app_accent"
                        android:visibility="invisible" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/recordedTab"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/recorded_label"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/app_text_secondary"
                        android:clickable="true"
                        android:focusable="true" />

                    <View
                        android:id="@+id/recordedTabIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@color/app_accent"
                        android:visibility="invisible" />
                </LinearLayout>
            </LinearLayout>

            <ListView
                android:id="@+id/stationListView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@color/app_divider"
                android:dividerHeight="1dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
