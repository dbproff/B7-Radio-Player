<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Unified Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/return_to_main"
                android:padding="12dp"
                android:src="@drawable/ic_return"
                app:tint="@color/app_text_primary" />

            <TextView
                android:id="@+id/detailsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/station_details"
                android:textColor="@color/app_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/detailsMenuAnchor"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Station options"
                android:padding="12dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/app_text_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textColor="@color/app_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/detailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Station Name"
            android:inputType="text"
            android:textSize="17sp"
            android:enabled="false"
            android:background="@null"
            android:textColor="@color/app_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Website"
            android:textColor="@color/app_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/detailWebsite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Website URL"
            android:inputType="textUri"
            android:textSize="15sp"
            android:enabled="false"
            android:background="@null"
            android:autoLink="web"
            android:linksClickable="true"
            android:textColor="@color/app_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stream URL"
            android:textColor="@color/app_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/detailSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Stream URL (.mp3, .aac, .m3u, .pls)"
            android:inputType="textUri"
            android:textSize="14sp"
            android:enabled="false"
            android:background="@null"
            android:textColor="@color/app_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tags"
            android:textColor="@color/app_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/detailTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Genre / Country / Bitrate"
            android:inputType="text"
            android:textSize="14sp"
            android:enabled="false"
            android:background="@null"
            android:textColor="@color/app_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Icon / Logo URL"
            android:textColor="@color/app_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/detailIconPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="Station icon preview" />
            </com.google.android.material.card.MaterialCardView>

            <EditText
                android:id="@+id/detailFavicon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="https://.../logo.png"
                android:inputType="textUri"
                android:textSize="14sp"
                android:enabled="false"
                android:background="@null"
                android:textColor="@color/app_text_primary" />

            <Button
                android:id="@+id/updateImageButton"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Update Image"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/detailFavoriteCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Favorite Station"
            android:textColor="@color/app_text_primary"
            android:enabled="false" />

        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/playButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Play Station"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/editButton"
                style="?android:attr/buttonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Save"
                android:textAllCaps="false"
                android:visibility="gone" />

            <Button
                android:id="@+id/deleteButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="Delete"
                android:textAllCaps="false"
                android:textColor="#CC0000"
                android:visibility="gone" />

            <Button
                android:id="@+id/cancelEditButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
